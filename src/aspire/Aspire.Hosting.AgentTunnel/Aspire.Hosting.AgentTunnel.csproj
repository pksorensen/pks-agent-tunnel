<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Aspire.Hosting.AgentTunnel</PackageId>
    <Version>0.0.1</Version>
    <Description>
      Aspire hosting integration that exposes local Aspire resources through pks-agent-tunnel.
      Drop-in replacement for Aspire.Hosting.DevTunnels — same AddDevTunnel / WithReference /
      WithAnonymousAccess / GetEndpoint surface, no Azure dependency.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.3" />
  </ItemGroup>

</Project>
